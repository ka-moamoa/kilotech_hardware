# Where the gateway and storage node(s) are (comma-separate several storage nodes).
GATEWAY_URL=http://gateway-host:8000
STORAGE_URLS=http://storage-host:8100
CLUSTER_TOKEN=

# Readable name in /v1/cluster; empty = <container hostname>-<random>.
WORKER_ID=
# Models this node serves (space-separated); missing ones are pulled at startup.
WORKER_MODELS=qwen2.5:3b
# Jobs run at once on this node. On CPU-only machines 1 is usually fastest per job.
WORKER_CONCURRENCY=1

# Directory of a pip-installable pipeline plugin to bake into the image.
WORKER_PLUGIN_DIR=../../kilotech_llm_local
# Only with compose.local-retrieval.yml (retrieval inside the worker, not on storage).
WORKER_CORPUS_DIR=../../kilotech_llm_local/Data/hawaiian_chunks
